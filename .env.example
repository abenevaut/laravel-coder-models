# LLM Configuration for Mistral AI
# Set to true to enable LLM qualification
LLM_ENABLED=false

# Mistral API configuration
LLM_API_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small

# Your Mistral API key (required for Mistral API)
# Get your API key at: https://console.mistral.ai/
LLM_API_KEY=your_mistral_api_key_here

# API request timeout in seconds
LLM_TIMEOUT=120

# Batch size for processing
LLM_BATCH_SIZE=10

# Alternative: Ollama local API (if you prefer local LLM)
# LLM_API_URL=http://localhost:11434
# LLM_MODEL=mistral:7b
# LLM_API_KEY=
